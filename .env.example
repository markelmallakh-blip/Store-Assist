# ── Store Assist · environment variables ─────────────────────────────────────
# Copy to .env.local for local dev; set the same keys in Netlify → Project configuration → Environment variables.

# ── Login ──
ADMIN_PASSWORD=choose-a-strong-password
# Optional. Derived from ADMIN_PASSWORD when empty. Any long random string (e.g. `openssl rand -hex 32`).
# SESSION_SECRET=

# ── Shopify ──
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Dev Dashboard app (recommended): Settings → Client ID / Client secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...or an older admin-created custom app token instead of the two above.
# SHOPIFY_ADMIN_TOKEN=
# Only if webhooks are signed with a different secret than the client secret.
# SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_LOCATION_ID=gid://shopify/Location/1234567890

# Optional: your deployed address (Netlify/Vercel provide it automatically), e.g. https://store-assist.netlify.app
# APP_URL=

# ── Confirmations ──
# Order metafield that means "customer confirmed".
# CONFIRMED_METAFIELD_NAMESPACE=custom
# CONFIRMED_METAFIELD_KEY=confirmed
# Order tag that means "confirmation message sent". Point this at the tag CK adds, once CK is set to tag orders.
CONFIRMATION_SENT_TAG=confirmation-sent
# ORDER_LOOKBACK_DAYS=60

# ── Bundles ──
# true = selling a bundle also subtracts its single items from Shopify stock (not just the sheet).
SYNC_BUNDLES_TO_SHOPIFY=false

# ── Actual inventory sheet (Google Sheets) ──
GOOGLE_SHEET_ID=
# The service account JSON key, pasted as one line (or base64 of the file).
GOOGLE_SERVICE_ACCOUNT_JSON=
# SHEET_INVENTORY_TAB=Inventory
# SHEET_LOG_TAB=Movements
# Column headers on the Inventory tab (change to match your sheet):
# SHEET_COL_VARIANT_ID=Variant ID
# SHEET_COL_SKU=SKU
# SHEET_COL_NAME=Product
# SHEET_COL_QTY=Actual Qty
# SHEET_COL_COST=Cost
# SHEET_COL_UPDATED_AT=Updated At
# Orders created before this date that are already fulfilled are never applied to the sheet.
# SHEET_SYNC_FROM=2026-09-15

# ── Receipt reading (OpenAI or Claude; can also be connected from Settings) ──
# RECEIPT_AI=openai            # openai | claude (default: whichever key is set)
# OPENAI_API_KEY=              # platform.openai.com → API keys (billed separately from ChatGPT)
# OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium

# ── Daily safety-net sync ── Optional; derived from SHOPIFY_CLIENT_SECRET when empty.
# CRON_SECRET=

# ── Local preview without Shopify credentials (never in production) ──
# SHOPIFY_FIXTURES_DIR=./fixtures
